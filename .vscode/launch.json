{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JAX: native CLI tests (CPU)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-p", "test_jax_cli.py", "-v"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "JAX_PLATFORMS": "cpu",
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
      },
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": true
    }
  ]
}
